# MySQL
MYSQL_ROOT_PASSWORD=root
MYSQL_PORT=3306

# Redis
REDIS_PORT=6379

# Token（必填；可用 `openssl rand -hex 64` 生成，禁止提交真实值）
TOKEN_SECRET=

# 本地调试开关；Swagger/Druid 默认关闭，Mock 支付仅用于本地开发
SWAGGER_ENABLED=false
DRUID_STAT_ENABLED=false
MALL_PAYMENT_MOCK_ENABLED=true

# 外部博客写入 API（默认关闭；仅在执行 V2.7.0 并创建客户端后开启）
BLOG_EXTERNAL_API_ENABLED=false
# 执行 V2.7.0 后设为 true；关闭公网 API 时仍保持 true，以继续清理审计/幂等数据
BLOG_EXTERNAL_API_SCHEMA_READY=false
# 外部 API 只接受该反向代理的直接连接；填写 LB/反向代理的固定私网地址
BLOG_EXTERNAL_API_TRUSTED_PROXY_IP=127.0.0.1

# 服务端口
BACKEND_PORT=8080
FRONTEND_PORT=80

# 前端 Nginx 反代后端地址（docker compose 默认同网络服务名 backend；前后端分开部署时改为宿主机 IP 或 172.17.0.1）
BACKEND_HOST=backend

# AI（推荐在管理后台「AI博客 → AI模型配置」中配置多厂商 Key）

# 对象存储（可选；对应 application.yml 中 novamall.oss）
# NOVAMALL_OSS_ENABLED=false
# NOVAMALL_OSS_KEY_ID=
# NOVAMALL_OSS_KEY_SECRET=
# NOVAMALL_OSS_BUCKET=
# NOVAMALL_OSS_ENDPOINT=oss-cn-beijing.aliyuncs.com
# NOVAMALL_OSS_DOMAIN=
